<Modal @ref="_modal" Title="Update expense category">
    <BodyTemplate>
        <EditForm Model="@_editingExpenseCategory" OnSubmit="UpdateExpenseCategoryAsync">

            <div class="pb-1">
                <label>Name:</label>
                <InputText class="form-control" @bind-Value="_editingExpenseCategory.Name" />
            </div>

            <button class="btn btn-primary w-100 pb-1" type="submit">Update</button>
        </EditForm>
    </BodyTemplate>
</Modal>

@code {
    private Modal _modal;
    private ExpenseCategoryModel _editingExpenseCategory;

    [Parameter]
    public EventCallback<ExpenseCategoryModel> OnValidSubmit { get; set; }

    [Parameter]
    public EventCallback<string> OnInvalidSubmit { get; set; }

    public void ShowModal(ExpenseCategoryModel editingExpenseCategory)
    {
        _editingExpenseCategory = editingExpenseCategory;

        _modal.ShowAsync();
    }

    private async Task UpdateExpenseCategoryAsync()
    {
        if (string.IsNullOrEmpty(_editingExpenseCategory.Name))
        {
            await OnInvalidSubmit.InvokeAsync("Name is empty.");

            return;
        }

        await OnValidSubmit.InvokeAsync(_editingExpenseCategory);
    }
}
