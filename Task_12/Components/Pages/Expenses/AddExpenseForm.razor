<EditForm Model="@expense" OnValidSubmit="AddExpense">
    <div class="pb-1">
        <label>Category:</label>
        <InputSelect class="form-select" @bind-Value="expense.Category">
            <option value="" disabled selected hidden></option>
            @foreach (ExpenseCategoryModel expenseCategory in ExpenseCategories)
            {
                <option value="@expenseCategory.Name">@expenseCategory.Name</option>
            }
        </InputSelect>
    </div>

    <div class="pb-1">
        <label>Amount:</label>
        <InputNumber class="form-control no-spinner" @bind-Value="expense.Amount" />
    </div>

    <button class="btn btn-primary pb-1" type="submit">Add</button>
</EditForm>

@code {
    private ExpenseModel expense = new();

    [Parameter]
    public IEnumerable<ExpenseCategoryModel> ExpenseCategories { get; set; }

    [Parameter]
    public EventCallback<HttpContent> OnExpenseAdded { get; set; }

    [Parameter]
    public EventCallback<string> OnInvalidDataInput { get; set; }

    public async Task AddExpense()
    {
        if (string.IsNullOrWhiteSpace(expense.Category))
        {
            await OnInvalidDataInput.InvokeAsync("Category is empty.");

            return;
        }

        if (expense.Amount <= 0)
        {
            await OnInvalidDataInput.InvokeAsync("Amount can't be less or equel zero.");

            return;
        }

        MultipartFormDataContent formDataContent = new()
        {
            { new StringContent(expense.Category), "category" },
            { new StringContent(expense.Amount.ToString()), "amount" }
        };

        await OnExpenseAdded.InvokeAsync(formDataContent);

        expense = new();
    }
}