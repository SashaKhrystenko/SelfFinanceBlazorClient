@page "/expenses"
@using Microsoft.AspNetCore.Http
@using Task_12.Providers.Network
@rendermode InteractiveServer

<PageTitle>Expenses</PageTitle>

<h1>Expenses</h1>

<ExpenseSortToolbar ExpenseSortOption="expenseSortOption" OnSelectbarChanges="UpdateExpenseListData" />

<ExpenseTable Expenses="_itemsOnPage" OnDeleteExpense="OnExpenseDeleteAsync" OnUpdateButtonPressed="ShowUpdateExpenseModal" />

<Paginator @ref="_paginator" ItemList="_expenses" OnPageChange="ShowPageData" AmountOfItemsOnPage="_amountOfItemsOnList" />

<AddExpenseForm ExpenseCategories="@_expenseCategories" OnExpenseAdded="OnSuccessExpenseAddingAsync" OnInvalidDataInput="ShowErrorPopup" />

<UpdateExpenseModal @ref="_updateExpenseModal" ExpenseCategories="_expenseCategories" OnInvalidSubmit="ShowErrorPopup" OnValidSubmit="UpdateExpense" />

<Popup @ref="_popup"/>

@code {
    private ExpenseSortOption expenseSortOption = new()
    {
        ExpenseFilter = ExpenseFilter.Date,
        ByDescending = true
    };

    private Paginator<ExpenseModel> _paginator;
    private UpdateExpenseModal _updateExpenseModal;
    private Popup _popup;

    private IEnumerable<ExpenseModel> _expenses;
    private IEnumerable<ExpenseCategoryModel> _expenseCategories;
    private IEnumerable<ExpenseModel> _itemsOnPage;

    private int _amountOfItemsOnList = 5;

    [Inject]
    private INetworkProvider _networkProvider { get; set; }

    protected override void OnInitialized()
    {
        _expenses = _networkProvider.Get<IEnumerable<ExpenseModel>>(
            SelfFinanceApiRoutes.ExpenseController.MakeGetSortedExpensesRoute(expenseSortOption.ExpenseFilter, expenseSortOption.ByDescending)
        ).ResponseData;

        _expenseCategories = _networkProvider.Get<IEnumerable<ExpenseCategoryModel>>(
            SelfFinanceApiRoutes.ExpenseCategoryController.MakeGetSortedExpenseCategoriesRoute(ExpenseCategoryFilter.Name, byDescending: false)
        ).ResponseData;

        _itemsOnPage = _expenses.Take(_amountOfItemsOnList);
    }

    private async Task UpdateExpenseListData()
    {
        RequestResult<IEnumerable<ExpenseModel>> requestResult = await _networkProvider.GetAsync<IEnumerable<ExpenseModel>>(
            SelfFinanceApiRoutes.ExpenseController.MakeGetSortedExpensesRoute(expenseSortOption.ExpenseFilter, expenseSortOption.ByDescending)
        );

        _expenses = requestResult.ResponseData;

        ShowPageData();

        StateHasChanged();
    }

    private async Task UpdateExpense(ExpenseModel expense)
    {
        RequestResult requestResult = await _networkProvider.PatchAsync(SelfFinanceApiRoutes.ExpenseController.UpdateExpense, expense);

        ShowPopupByResult(requestResult);

        await UpdateExpenseListData();
    }

    private async Task OnSuccessExpenseAddingAsync(HttpContent httpContent)
    {
        RequestResult requestResult = await _networkProvider.PostAsync(SelfFinanceApiRoutes.ExpenseController.AddExpense, httpContent);

        ShowPopupByResult(requestResult);

        await UpdateExpenseListData();
    }

    private async Task OnExpenseDeleteAsync(Guid expenseId)
    {
        RequestResult requestResult = await _networkProvider.DeleteAsync(SelfFinanceApiRoutes.ExpenseController.MakeDeleteExpenseRoute(expenseId));

        ShowPopupByResult(requestResult);

        await UpdateExpenseListData();
    }

    private void ShowErrorPopup(string message)
    {
        _popup.ShowError(message);
    }

    private void ShowUpdateExpenseModal(ExpenseModel expense)
    {
        _updateExpenseModal.ShowModal(expense);
    }

    private void ShowPageData()
    {
        _itemsOnPage = _expenses
            .Skip((_paginator.CurrentPage - 1) * _amountOfItemsOnList)
            .Take(_amountOfItemsOnList)
        ;
    }

    private void ShowPopupByResult(RequestResult requestResult)
    {
        if (requestResult.IsSuccess)
        {
            _popup.ShowSuccess(requestResult.Message);
        }
        else
        {
            _popup.ShowError(requestResult.Message);
        }
    }
}