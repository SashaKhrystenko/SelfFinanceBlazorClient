@page "/expenses"
@rendermode InteractiveServer

<PageTitle>Expenses</PageTitle>

<h1>Expenses</h1>

<ExpenseTable Expenses="@_expenses" OnDeleteExpense="UpdateExpenseListData"/>

<AddExpenseForm ExpenseCategories="@_expenseCategories" OnExpenseAdded="UpdateExpenseListData"/>

@code {
    private IReadOnlyList<ExpenseModel> _expenses;
    private IReadOnlyList<ExpenseCategoryModel> _expenseCategories;

    [Inject]
    private Client _client { get; set; }

    protected override void OnInitialized()
    {
        _expenses = _client.GetAllExpensesAsync().Result;
        _expenseCategories = _client.GetAllExpenseCategoriesAsync().Result;
    }

    public async Task UpdateExpenseListData()
    {
        _expenses = await _client.GetAllExpensesAsync();
    }
}