@page "/expenses"
@rendermode InteractiveServer

<PageTitle>Expenses</PageTitle>

<h1>Expenses</h1>

<ExpenseSortToolbar ExpenseSortOption="expenseSortOption" OnSelectbarChanges="UpdateExpenseListData" />

<ExpenseTable Expenses="@_listItems" OnDeleteExpense="UpdateExpenseListData" />

<AddExpenseForm ExpenseCategories="@_expenseCategories" OnExpenseAdded="UpdateExpenseListData" />

@code {
    private ExpenseSortOption expenseSortOption = new()
    {
        ExpenseFilter = ExpenseFilter.Date,
        ByDescending = true
    };

    private IReadOnlyList<ExpenseModel> _expenses;
    private IReadOnlyList<ExpenseCategoryModel> _expenseCategories;

    private IReadOnlyList<ExpenseModel> _listItems;

    [Inject]
    private Client _client { get; set; }

    public void UpdateExpenseListData()
    {
        _expenses = _client.GetSortedExpensesAsync(expenseSortOption.ExpenseFilter, expenseSortOption.ByDescending).Result;
    }

    protected override void OnInitialized()
    {
        _expenses = _client.GetSortedExpensesAsync(expenseSortOption.ExpenseFilter, expenseSortOption.ByDescending).Result;
        _expenseCategories = _client.GetSortedExpenseCategoriesAsync(ExpenseCategoryFilter.Name, byDescending: false).Result;
    }
}