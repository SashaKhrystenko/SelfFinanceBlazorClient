@if (_categoriesOnList?.Count() > 0)
{
    <table class="table table-striped">
        <thead>
            <tr>
                <td>Name</td>
                <td>Update</td>
                <td>Delete</td>
            </tr>
        </thead>
        <tbody>
            @foreach (IncomeCategoryModel category in _categoriesOnList)
            {
                <tr>
                    <td>@category.Name</td>
                    <td>
                        <Button Class="btn btn-primary" @onclick="() => OnUpdate.InvokeAsync(category)">Update</Button>
                    </td>
                    <td>
                        <Button Class="btn btn-primary" @onclick="() => OnCategoryDelete.InvokeAsync(category.Id)">Delete</Button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <Paginator @ref="_paginator" ItemList="IncomeCategories" AmountOfItemsOnPage="_amountCategoriesOnList" OnPageChange="ShowPageData" />
}
else
{
    <p class="text-center my-5 fs-3">No income categories found</p>
}

@code {
    private const int _amountCategoriesOnList = 5;

    private Paginator<IncomeCategoryModel> _paginator;
    private IEnumerable<IncomeCategoryModel> _categoriesOnList;

    [Parameter]
    public IEnumerable<IncomeCategoryModel> IncomeCategories { get; set; }

    [Parameter]
    public EventCallback<Guid> OnCategoryDelete { get; set; }

    [Parameter]
    public EventCallback<IncomeCategoryModel> OnUpdate { get; set; }

    protected override void OnParametersSet()
    {
        if (_paginator != null)
        {
            ShowPageData();
        }
        else
        {
            _categoriesOnList = IncomeCategories?.Take(_amountCategoriesOnList);
        }

        StateHasChanged();
    }

    private void ShowPageData()
    {
        _categoriesOnList = IncomeCategories?
            .Skip((_paginator.CurrentPage - 1) * _amountCategoriesOnList)
            .Take(_amountCategoriesOnList)
        ;
    }
}
