<table class="table table-striped">
    <thead>
        <tr>
            <td>Name</td>
            <td>Update</td>
            <td>Delete</td>
        </tr>
    </thead>
    <tbody>
        @foreach (IncomeCategoryModel category in _categoriesOnList)
        {
            <tr>
                <td>@category.Name</td>
                <td>
                    <Button Class="btn btn-primary" @onclick="() => NavigateToUpdateIncomeCategoryPage(category.Id)">Update</Button>
                </td>
                <td>
                    <Button Class="btn btn-primary" @onclick="() => OnCategoryDeletedAsync(category)">Delete</Button>
                </td>
            </tr>
        }
    </tbody>
</table>

<Paginator @ref="_paginator" ItemList="IncomeCategories" AmountOfItemsOnPage="_amountCategoriesOnList" OnPageChange="ShowPageData" />

@code {
    private const int _amountCategoriesOnList = 5;

    private Paginator<IncomeCategoryModel> _paginator;
    private IEnumerable<IncomeCategoryModel> _categoriesOnList;

    [Inject]
    private NavigationManager _navigationManager { get; set; }

    [Parameter]
    public IEnumerable<IncomeCategoryModel> IncomeCategories { get; set; }

    [Parameter]
    public EventCallback<IncomeCategoryModel> OnCategoryDelete { get; set; }

    protected override void OnInitialized()
    {
        _categoriesOnList = IncomeCategories.Take(_amountCategoriesOnList);
    }

    protected override void OnParametersSet()
    {
        if (_paginator != null)
        {
            ShowPageData();
        }

        StateHasChanged();
    }

    private async Task OnCategoryDeletedAsync(IncomeCategoryModel category)
    {
        await OnCategoryDelete.InvokeAsync(category);
    }

    private void NavigateToUpdateIncomeCategoryPage(Guid id)
    {
        _navigationManager.NavigateTo($"/income-categories/update-income-category/{id}");
    }

    private void ShowPageData()
    {
        _categoriesOnList = IncomeCategories
            .Skip((_paginator.CurrentPage - 1) * _amountCategoriesOnList)
            .Take(_amountCategoriesOnList)
        ;
    }
}
