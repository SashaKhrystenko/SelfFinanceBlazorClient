@page "/income-categories"
@rendermode InteractiveServer

<PageTitle>Income categories</PageTitle>

<h1>Income categories</h1>

<IncomeCategorySortToolbar OnSortToolbarChanged="UpdateListDataAsync" SortOption="_sortOption" />

<IncomeCategoryTable IncomeCategories="_incomeCategories" OnCategoryDelete="OnCategoryDeletedAsync" OnUpdate="ShowUpdateIncomeCategoryModal" />

<AddIncomeCategoryForm OnValidDataSubmit="OnCategoryAddedAsync" OnInvalidDataSubmit="ShowErrorPopup" />

<UpdateIncomeCategoryModal @ref="_updateIncomeCategoryModal" OnValidSubmit="OnIncomeUpdate" OnInvalidSubmit="ShowErrorPopup" />

<Popup @ref="_popup" />

@code {
    private IncomeCategorySortOption _sortOption = new()
    {
        IncomeCategoryFilter = IncomeCategoryFilter.Name,
        ByDescending = false
    };

    private Popup _popup;
    private UpdateIncomeCategoryModal _updateIncomeCategoryModal;

    private IEnumerable<IncomeCategoryModel> _incomeCategories;

    [Inject]
    private INetworkProvider _networkProvider { get; set; }

    protected override void OnInitialized()
    {
        _incomeCategories = _networkProvider.Get<IEnumerable<IncomeCategoryModel>>(
            SelfFinanceApiRoutes.IncomeCategoryController.MakeGetSortedIncomeCategoriesRoute(_sortOption.IncomeCategoryFilter, _sortOption.ByDescending)
        ).ResponseData;
    }

    private async Task OnCategoryAddedAsync(HttpContent httpContent)
    {
        RequestResult requestResult = await _networkProvider.PostAsync(SelfFinanceApiRoutes.IncomeCategoryController.AddIncomeCategory, httpContent);

        ShowPopupByResult(requestResult);

        await UpdateListDataAsync();
    }

    private async Task OnCategoryDeletedAsync(Guid categoryId)
    {
        RequestResult requestResult = await _networkProvider.DeleteAsync(SelfFinanceApiRoutes.IncomeCategoryController.MakeDeleteIncomeCategorydRoute(categoryId));

        ShowPopupByResult(requestResult);

        await UpdateListDataAsync();
    }

    private async Task UpdateListDataAsync()
    {
        RequestResult<IEnumerable<IncomeCategoryModel>> requestResult = await _networkProvider.GetAsync<IEnumerable<IncomeCategoryModel>>(
            SelfFinanceApiRoutes.IncomeCategoryController.MakeGetSortedIncomeCategoriesRoute(_sortOption.IncomeCategoryFilter, _sortOption.ByDescending)
        );

        _incomeCategories = requestResult.ResponseData;
    }

    private async Task OnIncomeUpdate(IncomeCategoryModel editingCategory)
    {
        RequestResult requestResult = await _networkProvider.PatchAsync(SelfFinanceApiRoutes.IncomeCategoryController.UpdateIncomeCategory, editingCategory);

        ShowPopupByResult(requestResult);

        await UpdateListDataAsync();
    }

    private void ShowUpdateIncomeCategoryModal(IncomeCategoryModel editingCategory)
    {
        _updateIncomeCategoryModal.ShowModal(editingCategory);
    }

    private void ShowErrorPopup(string message)
    {
        _popup.ShowError(message);
    }

    private void ShowPopupByResult(RequestResult requestResult)
    {
        if (requestResult.IsSuccess)
        {
            _popup.ShowSuccess(requestResult.Message);
        }
        else
        {
            _popup.ShowError(requestResult.Message);
        }
    }
}
