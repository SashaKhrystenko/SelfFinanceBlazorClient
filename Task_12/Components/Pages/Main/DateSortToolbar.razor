@using BlazorDateRangePicker

<div class="d-flex justify-content-end align-items-center my-1">
    <label class="me-2">Sort by date:</label>

    <DateRangePicker class="form-select form-select-sm w-auto" OnRangeSelect="OnRangeSelect" MaxDate="DateTimeOffset.Now" />
</div>

@code{
    [Parameter]
    public EventCallback<DateRange> OnRangeSelect { get; set; }

    private async Task OnRangeChange(DateRange dateRange)
    {
        if (dateRange == null)
        {
            throw new ArgumentNullException(nameof(dateRange), $"{nameof(dateRange)} is null.");
        }

        await OnRangeSelect.InvokeAsync(dateRange);
    }
}