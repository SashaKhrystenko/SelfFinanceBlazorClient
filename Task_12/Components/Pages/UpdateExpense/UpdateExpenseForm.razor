<EditForm Model="@Expense" OnValidSubmit="UpdateExpanse">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="pb-1">
        <label>Date:</label>
        <InputDate class="form-control" @bind-Value="Expense.Date" />
    </div>

    <div class="pb-1">
        <label>Category:</label>
        <InputSelect class="form-select" @bind-Value="Expense.Category">
            <option value="" disabled selected hidden></option>
            @foreach (ExpenseCategoryModel expanseCategory in ExpenseCategories)
            {
                <option value="@expanseCategory.Name">@expanseCategory.Name</option>
            }
        </InputSelect>
    </div>

    <div class="pb-1">
        <label>Amount:</label>
        <InputNumber class="form-control no-spinner" @bind-Value="Expense.Amount">@Expense.Amount</InputNumber>
    </div>

    <button class="btn btn-primary w-100 pb-1" type="submit">Update</button>
</EditForm>

@code {
    [Inject]
    private Client _client { get; set; }

    [Parameter]
    public ExpenseModel Expense { get; set; }

    [Parameter]
    public IReadOnlyList<ExpenseCategoryModel> ExpenseCategories { get; set; }

    [Parameter]
    public EventCallback<string> OnInvalidSubmit { get; set; }

    [Parameter]
    public EventCallback OnValidSubmit { get; set; }

    private void UpdateExpanse()
    {
        if (Expense.Date > DateOnly.FromDateTime(DateTime.Now))
        {
            OnInvalidSubmit.InvokeAsync("Date cannot be greater than today.");

            return;
        }

        if (string.IsNullOrWhiteSpace(Expense.Category))
        {
            OnInvalidSubmit.InvokeAsync("Category is empty.");

            return;
        }

        if (Expense.Amount <= 0)
        {
            OnInvalidSubmit.InvokeAsync("Amount can't be less or equel zero.");

            return;
        }

        _client.UpdateExpenseAsync(Expense);

        OnValidSubmit.InvokeAsync();
    }
}
