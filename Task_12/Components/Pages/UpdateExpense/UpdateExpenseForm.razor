<EditForm Model="@Expense" OnValidSubmit="UpdateExpanse">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="pb-1">
        <label>Date:</label>
        <InputDate class="form-control" @bind-Value="Expense.Date" />
    </div>

    <div class="pb-1">
        <label>Category:</label>
        <InputSelect class="form-select" @bind-Value="Expense.Category">
            <option value="" disabled selected hidden></option>
            @foreach (ExpenseCategoryModel expanseCategory in ExpenseCategories)
            {
                <option value="@expanseCategory.Name">@expanseCategory.Name</option>
            }
        </InputSelect>
    </div>

    <div class="pb-1">
        <label>Amount:</label>
        <InputNumber class="form-control no-spinner" @bind-Value="Expense.Amount">@Expense.Amount</InputNumber>
    </div>

    <div class="pb-1">
        <button class="btn btn-primary w-100" type="submit">Update</button>
    </div>
</EditForm>

@code {
    [Inject]
    private Client _client { get; set; }

    [Parameter]
    public ExpenseModel Expense { get; set; }

    [Parameter]
    public IReadOnlyList<ExpenseCategoryModel> ExpenseCategories { get; set; }

    [Parameter]
    public EventCallback OnInvalidSubmit { get; set; }

    [Parameter]
    public EventCallback OnValidSubmit { get; set; }

    private void UpdateExpanse() //TODO: Добавити валідацію
    {
        if (Expense.Amount <= 0)
        {
            OnInvalidSubmit.InvokeAsync();

            return;
        }

        _client.UpdateExpenseAsync(Expense);
    }
}
