@using System.Net.Http
@using System.Net.Http.Json

<table class="table table-striped">
    <thead>
        <tr>
            <td>@nameof(IncomeModel.Date)</td>
            <td>@nameof(IncomeModel.Category)</td>
            <td>@nameof(IncomeModel.Amount)</td>
            <td>Update</td>
            <td>Delete</td>
        </tr>
    </thead>
    <tbody>
        @foreach (IncomeModel income in Incomes)
        {
            <tr>
                <td>@income.Date</td>
                <td>@income?.Category</td>
                <td>@income.Amount</td>
                <td>
                    <button class="btn btn-primary" @onclick="() => OnUpdate.InvokeAsync(income)">Update</button>
                </td>
                <td>
                    <button class="btn btn-primary" @onclick="() => OnDelete.InvokeAsync(income)">Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@code 
{
    [Parameter]
    public IEnumerable<IncomeModel> Incomes { get; set; }

    [Parameter]
    public EventCallback<IncomeModel> OnDelete { get; set; }

    [Parameter]
    public EventCallback<IncomeModel> OnUpdate { get; set; }
}