@page "/incomes"
@rendermode InteractiveServer

<PageTitle>Incomes</PageTitle>

<h1>Incomes</h1>

<IncomeSortToolbar IncomeSortOption="_incomeSortOption" OnSelectbarChanges="UpdateIncomeListData" />

<IncomeTable Incomes="_itemsOnPage" OnDelete="@UpdateIncomeListData" />

<Paginator @ref="_paginator" ItemList="_incomes" AmountOfItemsOnPage="_amountOfItemsOnList" OnPageChange="ShowItemsOnPage" />

<AddIncomeForm incomeCategories="@_incomeCategories" OnIncomeAdded="@ShowSuccessPopupAndUpdateData" OnInvalidDataInput="ShowErrorPopup" />

<Popup @ref="_popup" />

@code {
    private IncomeSortOption _incomeSortOption = new()
    {
        IncomeFilter = IncomeFilter.Date,
        ByDescending = true
    };

    private Paginator<IncomeModel> _paginator;
    private Popup _popup;

    private IReadOnlyList<IncomeModel> _incomes;
    private IReadOnlyList<IncomeCategoryModel> _incomeCategories;

    private IEnumerable<IncomeModel> _itemsOnPage;

    private int _amountOfItemsOnList = 5;

    [Inject]
    private Client _client { get; set; }

    protected override void OnInitialized()
    {
        _incomes = _client.GetSortedIncomesAsync(_incomeSortOption.IncomeFilter, _incomeSortOption.ByDescending).Result;
        _incomeCategories = _client.GetSortedIncomeCategoriesAsync(IncomeCategoryFilter.Name, byDescending: false).Result;

        _itemsOnPage = _incomes.Take(_amountOfItemsOnList);
    }

    private void UpdateIncomeListData()
    {
        _incomes = _client.GetSortedIncomesAsync(_incomeSortOption.IncomeFilter, _incomeSortOption.ByDescending).Result;

        ShowItemsOnPage();
    }

    private void ShowItemsOnPage()
    {
        _itemsOnPage = _incomes
            .Skip((_paginator.CurrentPage - 1) * _amountOfItemsOnList)
            .Take(_amountOfItemsOnList)
        ;
    }

    private void ShowSuccessPopupAndUpdateData()
    {
        _popup.ShowSuccess("Income was added.");

        UpdateIncomeListData();
    }

    private void ShowErrorPopup(string message)
    {
        _popup.ShowError(message);
    }
}