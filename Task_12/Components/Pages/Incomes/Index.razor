@page "/incomes"
@rendermode InteractiveServer

<PageTitle>Incomes</PageTitle>

<h1>Incomes</h1>
<IncomeTable Incomes="@_incomes" OnDelete="@UpdateIncomeListData"/>

<AddIncomeForm incomeCategories="@_incomeCategories" OnIncomeAdded="@UpdateIncomeListData"/>

@code {
    private IReadOnlyList<IncomeModel> _incomes;
    private IReadOnlyList<IncomeCategoryModel> _incomeCategories;

    [Inject]
    public Client client { get; set; }

    protected override void OnInitialized()
    {
        _incomes = client.GetAllIncomesAsync().Result;
        _incomeCategories = client.GetAllIncomeCategoriesAsync().Result;
    }

    protected async Task UpdateIncomeListData()
    {
        _incomes = await client.GetAllIncomesAsync();
    }
}