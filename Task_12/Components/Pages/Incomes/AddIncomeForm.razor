<EditForm Model="@_income" OnValidSubmit="AddIncome">
    <div class="pb-1">
        <label>Category:</label>
        <InputSelect class="form-select" @bind-Value="_income.Category">
            <option value="" disabled selected hidden></option>
            @foreach (IncomeCategoryModel incomeCategory in incomeCategories)
            {
                <option value="@incomeCategory.Name">@incomeCategory.Name</option>
            }
        </InputSelect>
    </div>

    <div class="pb-1">
        <label>Amount:</label>
        <InputNumber class="form-control no-spinner" @bind-Value="_income.Amount" />
    </div>

    <button class="btn btn-primary pb-1" type="submit">Add</button>
</EditForm>

@code {
    [Parameter]
    public IEnumerable<IncomeCategoryModel> incomeCategories { get; set; }

    [Parameter]
    public EventCallback<HttpContent> OnIncomeAdded { get; set; }

    [Parameter]
    public EventCallback<string> OnInvalidDataInput { get; set; }

    private IncomeModel _income = new();

    private async Task AddIncome()
    {
        if (string.IsNullOrWhiteSpace(_income.Category))
        {
            await OnInvalidDataInput.InvokeAsync("Category is empty.");

            return;
        }

        if (_income.Amount <= 0)
        {
            await OnInvalidDataInput.InvokeAsync("Amount can't be less or equel zero.");

            return;
        }

        MultipartFormDataContent formDataContent = new()
        {
            { new StringContent(_income.Category), "category" },
            { new StringContent(_income.Amount.ToString()), "amount" }
        };

        await OnIncomeAdded.InvokeAsync(formDataContent);

        _income = new();
    }
}