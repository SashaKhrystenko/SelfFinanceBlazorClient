<EditForm Model="@income" OnValidSubmit="AddIncome">
    <div class="pb-1">
        <label>Category:</label>
        <InputSelect class="form-select" @bind-Value="income.Category">
            <option value="" disabled selected hidden></option>
            @foreach (IncomeCategoryModel incomeCategory in incomeCategories)
            {
                <option value="@incomeCategory.Name">@incomeCategory.Name</option>
            }
        </InputSelect>
    </div>

    <div class="pb-1">
        <label>Amount:</label>
        <InputNumber class="form-control no-spinner" @bind-Value="income.Amount" />
    </div>

    <button class="btn btn-primary pb-1" type="submit">Add</button>
</EditForm>

@code {
    [Inject]
    private Client _client { get; set; }

    [Parameter]
    public IReadOnlyList<IncomeCategoryModel> incomeCategories { get; set; }

    [Parameter]
    public EventCallback<IncomeModel> OnIncomeAdded { get; set; }

    [Parameter]
    public EventCallback<string> OnInvalidDataInput { get; set; }

    IncomeModel income = new();

    private async Task AddIncome()
    {
        if (string.IsNullOrWhiteSpace(income.Category))
        {
            await OnInvalidDataInput.InvokeAsync("Category is empty.");

            return;
        }

        if (income.Amount <= 0)
        {
            await OnInvalidDataInput.InvokeAsync("Amount can't be less or equel zero.");

            return;
        }

        await OnIncomeAdded.InvokeAsync(income);

        income = new();
    }
}