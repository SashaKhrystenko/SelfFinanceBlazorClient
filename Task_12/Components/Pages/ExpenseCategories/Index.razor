@page "/expense-categories"
@using Microsoft.AspNetCore.Http
@rendermode InteractiveServer

<PageTitle>Expense categories</PageTitle>

<h1>Expense categories</h1>

@if (_expenseCategories?.Count() > 0)
{
    <ExpanseCategorySortToolbar OnSortToolbarChanged="UpdateListDataAsync" SortOption="_sortOption" />
}

<ExpenseCategoryTable ExpenseCategories="_expenseCategories" OnCategoryDelete="OnCategoryDeletedAsync" OnUpdate="ShowUpdateExpenseCategoryModal" />

<AddExpenseCategoryForm OnValidDataSubmit="OnCategoryAddedAsync" OnInvalidDataSubmit="ShowErrorPopup" />

<UpdateExpenseCategoryModal @ref="_updateExpenseCategoryModal" OnValidSubmit="OnExpenseCategoryUpdate" OnInvalidSubmit="ShowErrorPopup" />

<Popup @ref="_popup" />

@code {
    private ExpenseCategorySortOption _sortOption = new()
    {
        ExpenseCategoryFilter = ExpenseCategoryFilter.Name,
        ByDescending = false
    };

    private Popup _popup;
    private UpdateExpenseCategoryModal _updateExpenseCategoryModal;

    private IEnumerable<ExpenseCategoryModel> _expenseCategories;

    [Inject]
    private SelfFinanceNetworkSettings _selfFinanceNetworkSettings { get; set; }

    [Inject]
    private INetworkProvider _networkProvider { get; set; }

    protected override async Task OnInitializedAsync()
    {
        RequestResult<IEnumerable<ExpenseCategoryModel>> getExpenseCategoriesResult = await _networkProvider.GetAsync<IEnumerable<ExpenseCategoryModel>>(
            _selfFinanceNetworkSettings,
            SelfFinanceApiRoutes.ExpenseCategoryController.MakeGetSortedExpenseCategoriesRoute(_sortOption.ExpenseCategoryFilter, _sortOption.ByDescending)
        );

        _expenseCategories = getExpenseCategoriesResult.ResponseData;
    }

    private async Task OnCategoryAddedAsync(HttpContent httpContent)
    {
        RequestResult requestResult = await _networkProvider.PostAsync(
            _selfFinanceNetworkSettings,
            SelfFinanceApiRoutes.ExpenseCategoryController.AddExpenseCategory,
            httpContent
        );

        if (requestResult.StatusCode == HttpStatusCode.InternalServerError)
        {
            _popup.ShowPopupByResult(requestResult, "Expense category could not be added");
        }
        else
        {
            _popup.ShowPopupByResult(requestResult);

            await UpdateListDataAsync();
        }
    }

    private async Task OnCategoryDeletedAsync(Guid id)
    {
        RequestResult requestResult = await _networkProvider.DeleteAsync(
            _selfFinanceNetworkSettings,
            SelfFinanceApiRoutes.ExpenseCategoryController.MakeDeleteExpenseCategorydRoute(id)
        );

        _popup.ShowPopupByResult(requestResult);

        await UpdateListDataAsync();
    }

    private async Task UpdateListDataAsync()
    {
        RequestResult<IEnumerable<ExpenseCategoryModel>> requestResult = await _networkProvider.GetAsync<IEnumerable<ExpenseCategoryModel>>(
            _selfFinanceNetworkSettings,
            SelfFinanceApiRoutes.ExpenseCategoryController.MakeGetSortedExpenseCategoriesRoute(_sortOption.ExpenseCategoryFilter, _sortOption.ByDescending)
        );

        _expenseCategories = requestResult.ResponseData;
    }

    private async Task OnExpenseCategoryUpdate(ExpenseCategoryModel expenseCategory)
    {
        RequestResult requestResult = await _networkProvider.PatchAsync(_selfFinanceNetworkSettings,
            SelfFinanceApiRoutes.ExpenseCategoryController.UpdateExpenseCategory,
            expenseCategory
        );

        if (requestResult.StatusCode == HttpStatusCode.InternalServerError)
        {
            _popup.ShowPopupByResult(requestResult, "Expense category could not be added");
        }
        else
        {
            _popup.ShowPopupByResult(requestResult);

            await UpdateListDataAsync();
        }
    }

    private void ShowUpdateExpenseCategoryModal(ExpenseCategoryModel expenseCategory)
    {
        _updateExpenseCategoryModal.ShowModal(expenseCategory);
    }

    private void ShowErrorPopup(string message)
    {
        _popup.ShowError(message);
    }
}
