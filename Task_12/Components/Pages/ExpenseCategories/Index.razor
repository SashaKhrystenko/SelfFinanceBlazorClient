@page "/expense-categories"
@rendermode InteractiveServer

<PageTitle>Expense categories</PageTitle>

<h1>Expense categories</h1>

<ExpanseCategorySortToolbar OnSortToolbarChanged="UpdateListDataAsync" SortOption="_sortOption" />

<ExpenseCategoryTable ExpenseCategories="_expenseCategories" OnCategoryDelete="OnCategoryDeletedAsync" />

<AddExpenseCategoryForm OnValidDataSubmit="OnCategoryAddedAsync" OnInvalidDataSubmit="ShowErrorPopup" />

<Popup @ref="_popup" />

@code {
    private ExpenseCategorySortOption _sortOption = new()
    {
        ExpenseCategoryFilter = ExpenseCategoryFilter.Name,
        ByDescending = false
    };

    private Popup _popup;

    private IReadOnlyList<ExpenseCategoryModel> _expenseCategories;

    [Inject]
    private Client _client { get; set; }

    protected override void OnInitialized()
    {
        _expenseCategories = _client.GetSortedExpenseCategoriesAsync(_sortOption.ExpenseCategoryFilter, _sortOption.ByDescending).Result;
    }

    private async Task OnCategoryAddedAsync(ExpenseCategoryModel category)
    {
        await _client.AddExpenseCategoryAsync(category.Name);

        _popup.ShowSuccess("Category was added.");

        await UpdateListDataAsync();
    }

    private async Task OnCategoryDeletedAsync(ExpenseCategoryModel category)
    {
        await _client.DeleteExpenseCategoryAsync(category);

        _popup.ShowError("Category was deleted.");

        await UpdateListDataAsync();
    }

    private async Task UpdateListDataAsync()
    {
        _expenseCategories = await _client.GetSortedExpenseCategoriesAsync(_sortOption.ExpenseCategoryFilter, _sortOption.ByDescending);
    }

    private void ShowErrorPopup(string message)
    {
        _popup.ShowError(message);
    }
}
