<EditForm Model="@Income" OnValidSubmit="UpdateIncome">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="pb-1">
        <label>Date:</label>
        <InputDate class="form-control" @bind-Value="Income.Date" />
    </div>

    <div class="pb-1">
        <label>Category:</label>
        <InputSelect class="form-select" @bind-Value="Income.Category">
            <option value="" disabled selected hidden></option>
            @foreach (IncomeCategoryModel incomeCategory in IncomeCategories)
            {
                <option value="@incomeCategory.Name">@incomeCategory.Name</option>
            }
        </InputSelect>
    </div>

    <div class="pb-1">
        <label>Amount:</label>
        <InputNumber class="form-control no-spinner" @bind-Value="Income.Amount">@Income.Amount</InputNumber>
    </div>

    <button class="btn btn-primary w-100" type="submit">Update</button>
</EditForm>


@code {
    [Inject]
    private Client _client { get; set; }

    [Parameter]
    public IncomeModel Income { get; set; }

    [Parameter]
    public IReadOnlyList<IncomeCategoryModel> IncomeCategories { get; set; }

    [Parameter]
    public EventCallback OnValidSubmit { get; set; }

    [Parameter]
    public EventCallback<string> OnInvalidSubmit { get; set; }

    private void UpdateIncome()
    {
        if (Income.Date > DateOnly.FromDateTime(DateTime.Now))
        {
            OnInvalidSubmit.InvokeAsync("Date cannot be greater than today.");

            return;
        }

        if (string.IsNullOrWhiteSpace(Income.Category))
        {
            OnInvalidSubmit.InvokeAsync("Category is empty.");

            return;
        }

        if (Income.Amount <= 0)
        {
            OnInvalidSubmit.InvokeAsync("Amount can't be less or equel zero.");

            return;
        }

        _client.UpdateIncomeAsync(Income);

        OnValidSubmit.InvokeAsync();
    }
}
