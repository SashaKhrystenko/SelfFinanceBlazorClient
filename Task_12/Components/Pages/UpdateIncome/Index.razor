@page "/incomes/update-income/{Id:guid}"
@rendermode InteractiveServer

<PageTitle>Update income</PageTitle>

<h1>Update income</h1>

<UpdateIncomeForm Income="_incomeModel" IncomeCategories="_incomeCategories" OnValidSubmit="ShowSuccessPopup" OnInvalidSubmit="ShowErrorPopup" />

<button class="btn btn-outline-danger w-100 my-1" @onclick="NagigateToIncomePage">Back to income page </button>

<Popup @ref="_popup" />

@code {
    private IncomeModel _incomeModel;
    private Popup _popup;

    private IReadOnlyList<IncomeCategoryModel> _incomeCategories;

    [Inject]
    private Client _client { get; set; }

    [Inject]
    private NavigationManager _navigationManager { get; set; }

    [Parameter]
    public Guid Id { get; set; }

    protected override void OnInitialized()
    {
        _incomeModel = _client.GetIncomeByIdAsync(Id).Result;
        _incomeCategories = _client.GetAllIncomeCategoriesAsync().Result;
    }

    private void NagigateToIncomePage()
    {
        _navigationManager.NavigateTo("/incomes");
    }

    private void ShowSuccessPopup()
    {
        _popup.ShowSuccess("Expense was updated.");
    }

    private void ShowErrorPopup(string message)
    {
        _popup.ShowError(message);
    }
}
