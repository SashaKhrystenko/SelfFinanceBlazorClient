<Modal @ref="_modal" Size="ModalSize.Small">
    <HeaderTemplate>
        @_title
    </HeaderTemplate>
    <BodyTemplate>
        <p>@_message</p>
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Danger" @onclick="_modal.HideAsync">Close</Button>
    </FooterTemplate>

</Modal>

@code {
    private Modal _modal;

    private string _title;
    private string _message;

    public void ShowSuccess(string message)
    {
        _title = "Success";
        _message = message;

        _modal.ShowAsync();
    }
    
    public void ShowError(string message)
    {
        _title = "Error";
        _message = message;

        _modal.ShowAsync();
    }
}
